# ==============================================================================
# CONFIGURACIÓN DE ENTORNO (PLANTILLA PÚBLICA SEGURA - SIN SECRETOS)
# Copia este archivo como .env y coloca tus credenciales reales:
# cp .env.example .env
# ==============================================================================

# Puerto de la API
PORT=4000
NODE_ENV=development

# Supabase PostgreSQL (Coloca los valores de tu Dashboard en tu archivo .env local)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu-anon-public-key-o-service-role

# Clave maestra de cifrado simétrico AES-256-GCM (Opcional, 32 caracteres recomendados)
ENCRYPTION_SECRET=genera-una-clave-secreta-para-cifrado-aes256

# URL del Frontend autorizado para CORS
FRONTEND_URL=http://localhost:5173
