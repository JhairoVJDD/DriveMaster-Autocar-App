# ==============================================================================
# CONFIGURACIÓN DE ENTORNO (PLANTILLA PÚBLICA SEGURA - SIN SECRETOS)
# Copia este archivo como .env y coloca tus credenciales reales:
# cp .env.example .env
# ==============================================================================

# Puerto de la API
PORT=4000
NODE_ENV=development

# Supabase PostgreSQL (Coloca los valores de tu Dashboard en tu archivo .env local)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu-anon-public-key-o-service-role

# Clave secreta para firma de JSON Web Tokens (JWT)
JWT_SECRET=tu-clave-secreta-jwt-super-segura-de-al-menos-32-caracteres

# Clave maestra de cifrado simétrico AES-256-GCM (Opcional, 32 caracteres recomendados)
ENCRYPTION_SECRET=genera-una-clave-secreta-para-cifrado-aes256

# Clave requerida para registrar usuarios Administradores o Instructores vía API
ADMIN_REGISTRATION_KEY=clave-secreta-para-crear-cuentas-admin

# Sincronización de usuarios de prueba en base de datos (false en producción)
SYNC_DEFAULT_USERS=false

# URL del Frontend autorizado para CORS
FRONTEND_URL=http://localhost:5173

